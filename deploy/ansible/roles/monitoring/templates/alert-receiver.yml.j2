# Отримувач сповіщень Alertmanager: приймає webhook і пише сповіщення в журнал
# (kubectl logs deploy/alert-receiver). Замінює email/Telegram у навчальному кластері.
apiVersion: v1
kind: ConfigMap
metadata:
  name: alert-receiver
  namespace: {{ monitoring_namespace }}
data:
  receiver.py: |
    import json
    from http.server import BaseHTTPRequestHandler, HTTPServer

    class Handler(BaseHTTPRequestHandler):
        def do_POST(self):
            body = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
            for a in body.get("alerts", []):
                print(f'{a["status"].upper():8} {a["labels"].get("alertname")} '
                      f'[{a["labels"].get("severity")}] ns={a["labels"].get("namespace")}: '
                      f'{a["annotations"].get("summary", "")}', flush=True)
            self.send_response(200)
            self.end_headers()

        def log_message(self, *args):
            pass

    print("alert-receiver listening on :8080", flush=True)
    HTTPServer(("", 8080), Handler).serve_forever()
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: alert-receiver
  namespace: {{ monitoring_namespace }}
  labels: { app: alert-receiver }
spec:
  replicas: 1
  selector:
    matchLabels: { app: alert-receiver }
  template:
    metadata:
      labels: { app: alert-receiver }
    spec:
      containers:
        - name: receiver
          image: python:3.12-alpine
          command: ["python", "-u", "/app/receiver.py"]
          ports:
            - containerPort: 8080
          resources:
            requests: { cpu: 10m, memory: 16Mi }
            limits: { cpu: 100m, memory: 64Mi }
          volumeMounts:
            - name: app
              mountPath: /app
      volumes:
        - name: app
          configMap:
            name: alert-receiver
---
apiVersion: v1
kind: Service
metadata:
  name: alert-receiver
  namespace: {{ monitoring_namespace }}
spec:
  selector: { app: alert-receiver }
  ports:
    - port: 8080
      targetPort: 8080
